---
import Base from "../layouts/Base.astro";
import SubNav from "../components/SubNav.astro";
import ProfileCard from "../components/ProfileCard.astro";
import DitherCursorGrid from "../components/DitherCursorGrid.astro";
import BootCurtain from "../components/BootCurtain.astro";
import { profilePageSchema } from "../lib/seo";
import {
  site,
  getProjects,
  getExperiences,
  getReleases,
  formatMonthYear,
  formatDate,
} from "../lib/content";

const projects = getProjects();
const recentProjects = [...projects].sort((a, b) => b.year - a.year || a.order - b.order).slice(0, 6);
const experiences = getExperiences();
const highlights = [
  {
    tag: "Game · C++",
    stat: "60 Hz ENet",
    title: "ColorFPS",
    hook: "Arena shooter where color mixing drives every combat rule.",
    href: "/work/color-fps",
  },
  {
    tag: "HPC",
    stat: "300B digits",
    title: "Γ(1/5)",
    hook: "Computed on 104 Xeon cores and verified independently twice.",
    href: "/work/gamma-1d5-300b",
  },
  {
    tag: "Prod · Gov",
    stat: "3,390 athletes",
    title: "AIFSM 2025",
    hook: "National meet platform, built solo from scratch in six weeks.",
    href: "/work/aifsm2025",
  },
];
const spotify = site.socials.find((x) => x.label === "Spotify")?.href ?? "#";
const current = getReleases().filter((r) => r.kind !== "archive").reverse();
const [leadRelease, ...otherReleases] = current;
const recentReleases = otherReleases.slice(0, 4);
const archive = getReleases().filter((r) => r.kind === "archive");
const insta = site.socials.find((s) => s.label === "Instagram")?.href ?? "#";
const photos = [
  {
    frame: "01A",
    title: "Foothills Valley",
    spec: "Canon 1300D · 24mm",
    year: "2026",
    src: "/photos/01-valley.avif",
  },
  {
    frame: "02A",
    title: "Ridge Lamp",
    spec: "26mm eq · f/1.8",
    year: "2025",
    src: "/photos/02-hillside.avif",
  },
  {
    frame: "03A",
    title: "Afterglow",
    spec: "26mm eq · f/1.8",
    year: "2025",
    src: "/photos/03-dusk.avif",
  },
];
const chapterCount = 7;
const chapterSvh = 200;
---

<Base jsonLd={profilePageSchema("/", `${site.name} — ${site.role}`, site.description)}>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    imagesrcset="/img/pfp-240.avif 240w, /img/pfp-480.avif 480w"
    imagesizes="(max-width: 639px) 166px, 480px"
    fetchpriority="high"
  />
  <noscript slot="head">
    <style>
      [data-spacer],
      [data-split-spacer],
      [data-rack-hint],
      [data-rack-canvas],
      [data-mobile-dock],
      [data-chapter-rail],
      [data-hud-wrap],
      [data-scroll-cue],
      [data-boot-curtain] {
        display: none !important;
      }
      [data-stage-clip] {
        position: static !important;
        overflow: visible !important;
        pointer-events: auto !important;
      }
      [data-stage-grid] {
        display: block !important;
        max-width: 60rem !important;
        padding: 5.5rem 1.5rem 4rem !important;
      }
      .stage {
        position: static !important;
        display: flex !important;
        opacity: 1 !important;
        visibility: visible !important;
        pointer-events: auto !important;
        transform: none !important;
        padding: 2.5rem 0 !important;
        border-top: 1px solid rgba(236, 232, 224, 0.1);
      }
      .stage::before {
        display: none !important;
      }
      .stage > * {
        opacity: 1 !important;
      }
    </style>
  </noscript>

  <BootCurtain />

  {/* subtle 20px cursor dot lattice + ordered Bayer dither trail */}
  <DitherCursorGrid />

  <SubNav path="/" variant="home" />

  <div
    data-rack-hint
    aria-hidden="true"
    class="pointer-events-none fixed inset-x-0 top-[calc(3.25rem+env(safe-area-inset-top))] z-20 flex justify-center px-4"
  >
    <span class="label-mono border border-paper/14 bg-rack/85 px-3 py-1 text-[9.5px] tracking-[0.14em] text-paper-dim backdrop-blur-sm">
      Tap a bay to open
    </span>
  </div>

  <canvas
    data-rack-canvas
    aria-hidden="true"
    class="pointer-events-none fixed inset-0 z-0 block h-full w-full"></canvas>

  {
    /* the spacer gives the page its scroll length; the stage itself is fixed */
  }
  <div data-spacer aria-hidden="true" style={`height:${chapterCount * chapterSvh}svh`}></div>

  <div data-stage-clip class="pointer-events-none fixed inset-0 z-10 overflow-hidden">
    <div
      data-stage-grid
      class="mx-auto grid h-full w-full max-w-[1920px] grid-cols-1 px-4 sm:px-6 lg:grid-cols-[minmax(0,1fr)_50%] lg:gap-6 lg:px-8 xl:pl-38 2xl:pl-44"
    >
      <div data-os-window>
        <div
          data-stage-col
          class="pointer-events-auto relative h-full"
          style="perspective: 1100px; perspective-origin: 100% 50%"
        >
        <div data-stage-feed class="contents">
        {/* 01 · ABOUT — identity first */}
        <section id="bay-about" aria-labelledby="bay-about-heading" class="stage" data-chapter data-active="true" style="--reveal: 1">
          <div class="grid max-w-4xl grid-cols-[5.75rem_1fr] items-center gap-x-3.5 gap-y-3 sm:grid-cols-[11.5rem_1fr] sm:gap-x-5 sm:gap-y-3.5 xl:grid-cols-[14rem_1fr] xl:gap-x-7 2xl:grid-cols-[18.5rem_1fr] 2xl:gap-x-10">
            <ProfileCard
              name={site.name}
              handle={`@${site.handle}`}
              status="Online"
              avatar="/img/pfp.jpg"
              contactLabel="Contact"
              tiltStrength={10}
              glare={0.45}
              parallax={5}
              holo={0.7}
              enableMobileTilt={true}
              compactMobile={true}
              class="col-start-1 row-start-1 w-[5.75rem] shrink-0 sm:w-[11.5rem] xl:row-span-2 xl:w-[14rem] 2xl:w-[18.5rem]"
            />

            <div class="col-start-2 row-start-1 min-w-0 xl:self-end">
              <p class="label text-ember">{site.tagline}</p>

              <h1 id="bay-about-heading" tabindex="-1" class="outline-none mt-1.5 font-serif text-[2.35rem] leading-[0.98] tracking-[-0.015em] text-paper sm:mt-2 sm:text-[2.85rem] xl:mt-2.5 xl:text-[3.75rem] 2xl:text-[4.65rem]">
                {site.name}
              </h1>

              <p class="mt-1.5 font-mono text-[10.5px] leading-relaxed tracking-[0.1em] text-paper-dim uppercase sm:mt-2.5 sm:text-[11.5px] xl:text-[12px]">
                {site.role}
              </p>

              <p class="mt-0.5 font-mono text-[10px] tracking-[0.08em] text-dim uppercase tabular-nums sm:mt-1 sm:text-[10.5px]">
                B.Tech CSE, UPES · 2025—2029
              </p>
            </div>

            <div class="col-span-2 min-w-0 xl:col-span-1 xl:col-start-2 xl:row-start-2 xl:self-start">
              <p class="max-w-[58ch] text-[13.5px] leading-[1.55] text-paper-dim sm:text-[14px] xl:text-[14.5px] xl:leading-[1.6] 2xl:text-[15.5px]">
                CS student building software, infrastructure, games, and the occasional hardware
                project. Most of my builds start out of curiosity and turn into deep dives across
                systems, code, and tooling.
              </p>

              <div class="mt-2 flex flex-wrap gap-x-4 gap-y-0.5 sm:mt-2.5 xl:mt-3.5 xl:gap-x-5 xl:gap-y-1">
                <a href={`mailto:${site.email}`} class="label link-underline inline-flex min-h-[36px] items-center text-ember">{site.email}</a>
                <a href="/about" class="label link-underline inline-flex min-h-[36px] items-center gap-1">About <span aria-hidden="true">→</span></a>
                <a href="/github" class="label link-underline inline-flex min-h-[36px] items-center">GitHub</a>
                <a href="/linkedin" class="label link-underline inline-flex min-h-[36px] items-center">LinkedIn</a>
                <a href="/resume" class="label link-underline inline-flex min-h-[36px] items-center">Résumé</a>
              </div>
            </div>
          </div>

          <div class="mt-3.5 max-w-4xl border-t border-paper/10 pt-2.5 xl:mt-5 xl:pt-3.5 2xl:mt-8 2xl:pt-5">
            <div class="mb-2 flex items-center justify-between gap-4 sm:mb-2.5">
              <p class="label-mono text-[10.5px] text-dim uppercase">
                Selected · explore the rack
              </p>
              <a href="/work" class="label-mono inline-flex min-h-[36px] items-center gap-1 text-[10.5px] text-ember hover:underline">
                All {projects.length} builds <span aria-hidden="true">→</span>
              </a>
            </div>

            <div class="grid gap-2.5 sm:grid-cols-3 xl:gap-3.5 2xl:gap-5">
              {highlights.map((h) => (
                <a
                  href={h.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group block border border-paper/10 bg-white/[0.015] px-3 py-2.5 transition-colors duration-200 hover:border-ember/55 hover:bg-white/[0.035] xl:px-3.5 xl:py-3"
                >
                  <div class="flex flex-wrap items-baseline justify-between gap-x-2 gap-y-0.5">
                    <span class="label-mono text-[10px] text-ember">{h.tag}</span>
                    <span class="label-mono text-[10px] text-paper-dim">{h.stat}</span>
                  </div>
                  <p class="mt-1.5 flex items-baseline justify-between gap-2 font-serif text-[21px] leading-[1.12] text-paper transition-colors group-hover:text-ember">
                    <span>{h.title}</span>
                    <span
                      aria-hidden="true"
                      class="font-mono text-[11px] opacity-55 transition-all group-hover:translate-x-0.5 group-hover:opacity-100"
                    >
                      ↗
                    </span>
                  </p>
                  <p class="mt-1 line-clamp-2 text-[12px] leading-snug text-paper-dim">
                    {h.hook}
                  </p>
                </a>
              ))}
            </div>
          </div>
        </section>

        {/* 02 · EXPERIENCE */}
        <section id="bay-experience" aria-labelledby="bay-experience-heading" class="stage" data-chapter>
          <p data-bay-tag class="label-mono mb-1.5 hidden text-[10px] text-dim">02 // RUNTIME</p>
          <div class="flex items-baseline justify-between gap-4">
            <h2 id="bay-experience-heading" tabindex="-1" class="chapter-title outline-none">Experience</h2>
            <div class="flex items-center gap-4">
              <a href="/downloads/resume.pdf" target="_blank" rel="noopener noreferrer" class="label-mono inline-flex min-h-[36px] items-center gap-1 text-[11px] text-paper-dim hover:text-ember">
                PDF <span aria-hidden="true">↗</span>
              </a>
              <a href="/resume" class="label-mono inline-flex min-h-[36px] items-center gap-1 text-[11px] text-ember hover:underline">
                Full résumé <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>

          <div class="mt-6 flex flex-col justify-between gap-1 border-y border-paper/15 py-4 sm:flex-row sm:items-baseline">
            <div>
              <p class="text-[15px] font-medium text-paper">B.Tech CSE</p>
              <p class="mt-0.5 text-[12.5px] text-dim">
                University of Petroleum and Energy Studies · Dehradun
              </p>
            </div>
            <p class="label-mono shrink-0 text-[11px] text-dim">2025 — 2029 · CGPA 8.49</p>
          </div>

          <ol class="relative mt-5 space-y-5 border-l border-paper/15 pl-5 sm:mt-7 sm:space-y-6 sm:pl-6">
            {experiences.map((e, idx) => (
              <li class="relative grid gap-1.5 sm:grid-cols-[152px_1fr] sm:gap-8">
                <span
                  aria-hidden="true"
                  class:list={[
                    "absolute top-[7px] -left-[23.5px] h-1.5 w-1.5 sm:-left-[27.5px]",
                    idx === 0 ? "bg-ember" : "bg-paper/35",
                  ]}
                />
                <div>
                  <p class="label-mono text-[11px] tracking-[0.06em] text-paper-dim">
                    {formatMonthYear(e.start)} — {e.end ? formatMonthYear(e.end) : "Now"}
                  </p>
                  <p class="mt-1 text-[11.5px] text-dim">{e.location}</p>
                </div>
                <div class="min-w-0">
                  <p class="text-[15px] font-medium text-paper">
                    {e.title} <span class="font-normal text-paper-dim">· {e.company}</span>
                  </p>
                  <p class="mt-1.5 max-w-xl text-[13.5px] leading-relaxed text-paper-dim">{e.summary}</p>
                  {e.stack?.length > 0 && (
                    <p class="label-mono mt-2 text-[10.5px] tracking-[0.06em] text-dim">
                      {e.stack.join(" · ")}
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>

        {/* 03 · PROJECTS */}
        <section id="bay-projects" aria-labelledby="bay-projects-heading" class="stage" data-chapter>
          <p data-bay-tag class="label-mono mb-1.5 hidden text-[10px] text-dim">03 // ARTIFACT</p>
          <div class="flex items-baseline justify-between gap-4">
            <h2 id="bay-projects-heading" tabindex="-1" class="chapter-title outline-none">Projects</h2>
            <div class="flex items-center gap-4">
              <span class="label-mono text-[11px] text-dim">
                {String(recentProjects.length).padStart(2, "0")} recent / {projects.length}
              </span>
              <a href="/work" class="label-mono inline-flex min-h-[36px] items-center gap-1 text-[11px] text-ember hover:underline">
                All work <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>

          <ul class="mt-4 grid gap-3 sm:grid-cols-2 2xl:gap-4">
            {recentProjects.map((p, idx) => {
              const leadMetric = p.metrics?.[0];
              const ext = p.links[0];
              return (
                <li class="group flex flex-col justify-between border border-paper/10 bg-white/[0.015] p-3.5 transition-colors duration-200 hover:border-ember/55 hover:bg-white/[0.03] 2xl:p-4">
                  <div>
                    <div class="flex items-baseline justify-between gap-2">
                      <div class="flex items-baseline gap-2">
                        <span class="label-mono text-[10px] text-ember">
                          {String(idx).padStart(2, "0")}
                        </span>
                        <span class="label-mono text-[10px] text-paper-dim">{p.category}</span>
                      </div>
                      <span class="label-mono text-[10px] text-dim">{p.year}</span>
                    </div>

                    <a
                      href={`/work/${p.id}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="mt-1.5 block text-[15px] leading-snug font-medium text-paper transition-colors group-hover:text-ember"
                    >
                      {p.title}
                    </a>

                    <p class="mt-1 line-clamp-2 text-[12.5px] leading-snug text-paper-dim">{p.tagline}</p>
                  </div>

                  <div class="mt-3 flex items-baseline justify-between gap-2 border-t border-white/[0.06] pt-2">
                    <span class="label-mono truncate text-[10px] text-paper-dim">
                      {leadMetric
                        ? `${leadMetric.value} ${leadMetric.label}`
                        : p.stack.slice(0, 2).join(" · ")}
                    </span>
                    {ext ? (
                      <a
                        href={ext.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="label-mono shrink-0 text-[10px] text-ember/95 hover:text-ember hover:underline"
                      >
                        {ext.label} <span aria-hidden="true">↗</span>
                      </a>
                    ) : (
                      <a
                        href={`/work/${p.id}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="label-mono shrink-0 text-[10px] text-dim hover:text-ember"
                      >
                        Case study <span aria-hidden="true">→</span>
                      </a>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>

          <div class="mt-4 flex items-center justify-between gap-4 border-t border-paper/10 pt-2">
            <span class="label-mono text-[10.5px] text-dim">
              +{projects.length - recentProjects.length} earlier builds in archive
            </span>
            <a href="/work" class="label-mono inline-flex min-h-[36px] items-center gap-1 text-[10.5px] text-ember hover:underline">
              Explore all {projects.length} builds <span aria-hidden="true">→</span>
            </a>
          </div>
        </section>

        {/* 04 · MUSIC */}
        <section id="bay-music" aria-labelledby="bay-music-heading" class="stage" data-chapter>
          <p data-bay-tag class="label-mono mb-1.5 hidden text-[10px] text-dim">04 // DAC</p>
          <div class="flex items-baseline justify-between gap-4">
            <h2 id="bay-music-heading" tabindex="-1" class="chapter-title outline-none">Music</h2>
            <div class="flex items-center gap-4">
              <a
                href={spotify}
                target="_blank"
                rel="noopener noreferrer"
                class="label-mono inline-flex min-h-[36px] items-center gap-1 text-[11px] text-paper-dim hover:text-ember"
              >
                Spotify <span aria-hidden="true">↗</span>
              </a>
              <a href="/music" class="label-mono inline-flex min-h-[36px] items-center gap-1 text-[11px] text-ember hover:underline">
                All music <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>

          <p class="mt-3 max-w-xl text-[14px] leading-relaxed text-paper-dim">
            Instrumental and electronic releases — composed, mixed, and mastered independently.
          </p>

          {leadRelease && (
            <a
              href={leadRelease.url || spotify}
              target="_blank"
              rel="noopener noreferrer"
              class="group mt-5 flex items-center gap-4 border border-paper/12 bg-white/[0.015] p-3.5 transition-colors duration-200 hover:border-ember/60 hover:bg-white/[0.03] sm:gap-5 sm:p-4"
            >
              <img
                src={leadRelease.cover}
                alt={leadRelease.title}
                loading="lazy"
                decoding="async"
                width="80"
                height="80"
                class="h-16 w-16 shrink-0 border border-paper/10 object-cover sm:h-20 sm:w-20"
              />
              <div class="min-w-0 flex-1">
                <div class="flex items-baseline justify-between gap-2">
                  <span class="label-mono text-[10px] text-ember">
                    Latest {leadRelease.kind}
                  </span>
                  <span class="label-mono text-[10px] text-dim">
                    {formatDate(leadRelease.date)}
                  </span>
                </div>
                <p class="mt-1 flex items-baseline justify-between gap-2 font-serif text-2xl leading-[1.12] text-paper transition-colors group-hover:text-ember">
                  <span class="truncate">{leadRelease.title}</span>
                  <span aria-hidden="true" class="font-mono text-xs opacity-65 transition-opacity group-hover:opacity-100">
                    ↗
                  </span>
                </p>
                {leadRelease.tracks && leadRelease.tracks.length > 0 && (
                  <p class="mt-1 truncate text-[12.5px] text-dim">
                    {leadRelease.tracks.length} tracks ·{" "}
                    {leadRelease.tracks
                      .slice(0, 4)
                      .map((t) => t.title)
                      .join(", ")}
                  </p>
                )}
              </div>
            </a>
          )}

          <ul class="mt-3 grid gap-3 sm:grid-cols-2">
            {recentReleases.map((r) => (
              <li>
                <a
                  href={r.url || spotify}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center gap-3.5 border border-paper/10 bg-white/[0.015] p-3 transition-colors duration-200 hover:border-ember/55 hover:bg-white/[0.03]"
                >
                  <img
                    src={r.cover}
                    alt={r.title}
                    loading="lazy"
                    decoding="async"
                    width="52"
                    height="52"
                    class="h-12 w-12 shrink-0 border border-paper/10 object-cover"
                  />
                  <div class="min-w-0 flex-1">
                    <div class="flex items-baseline justify-between gap-2">
                      <span class="label-mono text-[10px] text-dim">
                        {r.kind === "album" ? `Album · ${r.tracks?.length ?? 0} tracks` : "Single"}
                      </span>
                      <span class="label-mono shrink-0 text-[10px] text-dim">
                        {formatDate(r.date)}
                      </span>
                    </div>
                    <p class="mt-1 flex items-baseline justify-between gap-2 text-[14px] font-medium text-paper transition-colors group-hover:text-ember">
                      <span class="truncate">{r.title}</span>
                      <span aria-hidden="true" class="font-mono text-[10px] opacity-55 group-hover:opacity-100">↗</span>
                    </p>
                  </div>
                </a>
              </li>
            ))}
          </ul>

          <div class="mt-4 flex items-center justify-between gap-4 border-t border-paper/10 pt-2">
            <span class="label-mono text-[10.5px] text-dim">
              +{otherReleases.length - recentReleases.length + archive.length} earlier releases &amp;
              Cider Gamer archive
            </span>
            <a href="/music" class="label-mono inline-flex min-h-[36px] items-center gap-1 text-[10.5px] text-ember hover:underline">
              Full discography <span aria-hidden="true">→</span>
            </a>
          </div>
        </section>

        {/* 05 · PHOTOGRAPHY */}
        <section id="bay-photo" aria-labelledby="bay-photo-heading" class="stage" data-chapter>
          <p data-bay-tag class="label-mono mb-1.5 hidden text-[10px] text-dim">05 // DAM</p>
          <div class="flex flex-wrap items-baseline justify-between gap-4">
            <h2 id="bay-photo-heading" tabindex="-1" class="chapter-title outline-none">Photography</h2>
            <a
              href={insta}
              target="_blank"
              rel="noopener noreferrer"
              class="label-mono inline-flex min-h-[36px] items-center gap-1 text-[11px] text-ember hover:underline"
            >
              Instagram <span aria-hidden="true">↗</span>
            </a>
          </div>

          <p class="mt-3 max-w-xl text-[14px] leading-relaxed text-paper-dim">
            Event, street, and landscape frames — occasional work shot for light and mood rather than volume.
          </p>

          <ul class="mt-4 grid gap-2.5 sm:mt-5 sm:grid-cols-3 sm:gap-3">
            {photos.map((ph) => (
              <li>
                <button
                  type="button"
                  data-photo-open
                  data-src={ph.src}
                  data-title={ph.title}
                  data-meta={`${ph.frame} · ${ph.spec} · ${ph.year}`}
                  class="group flex w-full items-center overflow-hidden border border-paper/10 bg-white/[0.015] text-left transition-colors duration-200 hover:border-ember/55 hover:bg-white/[0.03] sm:block"
                >
                  <div class="aspect-[4/3] w-24 shrink-0 overflow-hidden border-r border-paper/10 bg-rack sm:w-full sm:border-r-0 sm:border-b">
                    <img
                      src={ph.src}
                      alt={ph.title}
                      loading="lazy"
                      decoding="async"
                      width="1200"
                      height="900"
                      class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                    />
                  </div>
                  <div class="min-w-0 flex-1 p-2.5 sm:p-3">
                    <div class="flex items-baseline justify-between gap-2">
                      <span class="label-mono text-[10px] text-ember">{ph.frame}</span>
                      <span class="label-mono text-[10px] text-dim">{ph.year}</span>
                    </div>
                    <p class="mt-0.5 truncate text-[13.5px] font-medium text-paper transition-colors group-hover:text-ember sm:mt-1">
                      {ph.title}
                    </p>
