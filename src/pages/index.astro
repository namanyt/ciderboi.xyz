<script is:inline>
  // Resolve presentation geometry before first paint so neither layout nor chapter 0 flashes.
  (function () {
    const w = window.innerWidth;
    const h = window.innerHeight;
    const aspect = w / Math.max(1, h);
    const root = document.documentElement;
    const layout = w >= 960 && h >= 540 && aspect >= 1.02 ? "split" : "window";
    root.dataset.layout = layout;
    root.dataset.windowFrame = w >= 560 && h >= 640 ? "floating" : "compact";
    root.dataset.windowOpen = "true";

    if (layout === "window") {
      const sp = document.querySelector("[data-spacer]");
      if (sp) sp.style.height = "0px";
    } else if (window.scrollY > 40) {
      const ch0 = document.querySelector("[data-chapter]");
      if (ch0) {
        ch0.setAttribute("data-active", "false");
        ch0.style.setProperty("--reveal", "0");
      }
    }
  })();
</script>

<script>
  import type { Handle } from "../scene/rack";
  import { createBootCurtain } from "../lib/bootCurtain";

  const bootCurtain = createBootCurtain();
  bootCurtain.setStage("LOADING FONTS", 0.22);

  const BAY_META = [
    { code: "IAM", title: "About" },
    { code: "RUNTIME", title: "Experience" },
    { code: "ARTIFACT", title: "Projects" },
    { code: "DAC", title: "Music" },
    { code: "DAM", title: "Photos" },
    { code: "GATEWAY", title: "Connect" },
    { code: "UPS / PDU", title: "Footer" },
  ];

  const getLayoutState = (w = window.innerWidth, h = window.innerHeight) => {
    const aspect = w / Math.max(1, h);
    const mode: "split" | "window" = w >= 960 && h >= 540 && aspect >= 1.02 ? "split" : "window";
    const windowFrame: "floating" | "compact" = w >= 560 && h >= 640 ? "floating" : "compact";
    return { mode, windowFrame };
  };

  const canvas = document.querySelector<HTMLCanvasElement>("[data-rack-canvas]");
  const spacer = document.querySelector<HTMLElement>("[data-spacer]");
  const chapters = Array.from(document.querySelectorAll<HTMLElement>("[data-chapter]"));
  const stageClip = document.querySelector<HTMLElement>("[data-stage-clip]");
  const stageCol = document.querySelector<HTMLElement>("[data-stage-col]");
  const osWindow = document.querySelector<HTMLElement>("[data-os-window]");
  const winPrev = document.querySelector<HTMLButtonElement>("[data-win-prev]");
  const winNext = document.querySelector<HTMLButtonElement>("[data-win-next]");
  const winNextLabel = document.querySelector<HTMLElement>("[data-win-next-label]");
  const winToggle = document.querySelector<HTMLButtonElement>("[data-win-toggle]");
  const winProgress = document.querySelector<HTMLElement>("[data-win-progress]");
  const winResume = document.querySelector<HTMLButtonElement>("[data-win-resume]");
  const winResumeLabel = document.querySelector<HTMLElement>("[data-win-resume-label]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  let layoutState = getLayoutState();
  let windowOpen = true;
  document.documentElement.dataset.layout = layoutState.mode;
  document.documentElement.dataset.windowFrame = layoutState.windowFrame;
  document.documentElement.dataset.windowOpen = "true";
  if (osWindow) osWindow.toggleAttribute("data-lenis-prevent", layoutState.mode === "window");

  // Soft ordered 8x8 Bayer feather strip (repeating vertically) along the bay clip edge
  const DITHER_CELL = 4;
  const DITHER_TILE_H = DITHER_CELL * 8;
  const buildDitherEdgeUrl = (): string => {
    const BAYER_8 = [
      [0, 32, 8, 40, 2, 34, 10, 42],
      [48, 16, 56, 24, 50, 18, 58, 26],
      [12, 44, 4, 36, 14, 46, 6, 38],
      [60, 28, 52, 20, 62, 30, 54, 22],
      [3, 35, 11, 43, 1, 33, 9, 41],
      [51, 19, 59, 27, 49, 17, 57, 25],
      [15, 47, 7, 39, 13, 45, 5, 37],
      [63, 31, 55, 23, 61, 29, 53, 21],
    ].map((row) => row.map((v) => (v + 0.5) / 64));

    const stripW = 136;
    const c = document.createElement("canvas");
    c.width = stripW;
    c.height = DITHER_TILE_H;
    const g = c.getContext("2d");
    if (!g) return "";

    const cols = Math.ceil(stripW / DITHER_CELL);
    for (let gy = 0; gy < 8; gy++) {
      const bRow = BAYER_8[gy];
      for (let gx = 0; gx < cols; gx++) {
        const u = 1 - (gx * DITHER_CELL + DITHER_CELL * 0.5) / stripW;
        if (u <= 0) continue;
        const s = u * u * (3 - 2 * u);
        // Soft-quantized Bayer: preserves ordered grid texture without harsh 1-bit cutouts on text
        const alpha = Math.max(0, Math.min(1, (s - bRow[gx & 7] * 0.58) / 0.42));
        if (alpha <= 0.01) continue;
        g.fillStyle = `rgba(0, 0, 0, ${alpha.toFixed(3)})`;
        g.fillRect(gx * DITHER_CELL, gy * DITHER_CELL, DITHER_CELL, DITHER_CELL);
      }
    }
    return c.toDataURL();
  };

  const ditherEdgeUrl = stageClip ? buildDitherEdgeUrl() : "";
  if (stageClip && ditherEdgeUrl) {
    const maskExpr = `linear-gradient(#000, #000), url("${ditherEdgeUrl}")`;
    stageClip.style.maskImage = maskExpr;
    stageClip.style.webkitMaskImage = maskExpr;
    stageClip.style.maskRepeat = "no-repeat, repeat-y";
    stageClip.style.webkitMaskRepeat = "no-repeat, repeat-y";
  }

  const smoothstep = (e0: number, e1: number, x: number) => {
    const t = Math.max(0, Math.min(1, (x - e0) / (e1 - e0)));
    return t * t * (3 - 2 * t);
  };

  const cubicBezier = (x1: number, y1: number, x2: number, y2: number) => {
    const cx = 3 * x1;
    const bx = 3 * (x2 - x1) - cx;
    const ax = 1 - cx - bx;
    const cy = 3 * y1;
    const by = 3 * (y2 - y1) - cy;
    const ay = 1 - cy - by;
    const sampleX = (t: number) => ((ax * t + bx) * t + cx) * t;
    const sampleDX = (t: number) => (3 * ax * t + 2 * bx) * t + cx;
    const sampleY = (t: number) => ((ay * t + by) * t + cy) * t;
    return (e0: number, e1: number, x: number) => {
      const u = Math.max(0, Math.min(1, (x - e0) / (e1 - e0)));
      if (u <= 0) return 0;
      if (u >= 1) return 1;
      let t = u;
      for (let i = 0; i < 6; i++) {
        const err = sampleX(t) - u;
        if (Math.abs(err) < 1e-5) break;
        const d = sampleDX(t);
        if (Math.abs(d) < 1e-5) break;
        t -= err / d;
      }
      t = Math.max(0, Math.min(1, t));
      return sampleY(t);
    };
  };

  // Apple fluid motion curves: gentle launch + long exponential deceleration settle
  const appleOut = cubicBezier(0.22, 1, 0.36, 1);
  const appleSheet = cubicBezier(0.32, 0.72, 0, 1);
  const appleGlide = cubicBezier(0.34, 0.06, 0.14, 1);

  /**
   * Maps continuous scroll scrub [0 .. N-1] into mechanical phases per unit transition:
   * - No open dwell on the top section (i === 0 start) or bottom section (i === n - 2 end)
   *   so scrolling from the very top or very bottom responds immediately.
   * - Small 0.08 dwell on intermediate sections.
   * Active span [startDwell .. 1 - endDwell]:
   * 0.00..0.18 content goes IN -> 0.18..0.34 drawer CLOSES ->
   * 0.34..0.66 rack SCROLLS -> 0.66..0.82 next drawer PULLS OUT ->
   * 0.82..1.00 next content PRESENTS.
   */
  const computePose = (s: number, n: number) => {
    const clamped = Math.max(0, Math.min(n - 1, s));
    const i = Math.min(Math.max(0, Math.floor(clamped)), Math.max(0, n - 2));
    const u = n > 1 ? clamped - i : 0;

    const startDwell = i === 0 ? 0 : 0.08;
    const endDwell = i >= n - 2 ? 0 : 0.08;
    const span = Math.max(0.01, 1 - startDwell - endDwell);
    const p = Math.max(0, Math.min(1, (u - startDwell) / span));

    const contentIn = smoothstep(0.0, 0.18, p);
    const drawerClose = smoothstep(0.18, 0.34, p);
    const rackT = smoothstep(0.34, 0.66, p);
    const drawerOpen = smoothstep(0.66, 0.82, p);
    const contentOut = smoothstep(0.82, 1.0, p);

    const ejects = new Array<number>(n).fill(0);
    if (n > 1) {
      ejects[i] = 1 - drawerClose;
      ejects[i + 1] = drawerOpen;
    } else if (n === 1) {
      ejects[0] = 1;
    }

    const toNext = p >= 0.5 && n > 1;
    const active = toNext ? i + 1 : i;
    const reveal = toNext ? contentOut : 1 - contentIn;

    return {
      fromUnit: i,
      toUnit: Math.min(n - 1, i + 1),
      rackT,
      ejects,
      active,
      reveal,
    };
  };

  const getTargetScrub = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    return max > 0
      ? Math.max(0, Math.min(chapters.length - 1, (window.scrollY / max) * (chapters.length - 1)))
      : 0;
  };

  let rackHandle: Handle | null = null;
  let scrub = getTargetScrub();
  let lastPose = computePose(scrub, chapters.length);
  let activeIndex = lastPose.active;
  let currentReveal = reduce ? 1 : lastPose.reveal;

  type JumpState = {
    from: number;
    to: number;
    start: number;
    closeDur: number;
    scrollDur: number;
    openDur: number;
    dur: number;
    startReveal: number;
    startEject: number;
    startY: number;
    destY: number;
    wheelAccum: number;
  };
  let jump: JumpState | null = null;

  type FastTravelState = {
    phase: "closing" | "scrolling" | "opening";
    from: number;
    to: number;
    rackS: number;
    t: number;
    startReveal: number;
    startEject: number;
    lastTarget: number;
    stableFrames: number;
  };
  let fastTravel: FastTravelState | null = null;

  let openedRackUnit = layoutState.mode === "window" && windowOpen ? 0 : -1;
  const windowEjects = chapters.map((_, i) => (i === openedRackUnit ? 1 : 0));

  const updateWindowChrome = (idx: number) => {
    const total = chapters.length;
    const meta = BAY_META[idx] ?? { code: `U${idx + 1}`, title: `Unit ${idx + 1}` };
    const nextIdx = (idx + 1) % total;
    const nextMeta = BAY_META[nextIdx] ?? { code: `U${nextIdx + 1}`, title: `Unit ${nextIdx + 1}` };
    const prevIdx = idx - 1;
    const prevMeta = prevIdx >= 0 ? BAY_META[prevIdx] : null;

    if (winProgress) {
      winProgress.textContent = `${idx + 1}/${total}`;
    }
    if (winPrev) {
      winPrev.disabled = idx <= 0;
      winPrev.setAttribute(
        "aria-label",
        prevMeta ? `Previous section: ${prevMeta.title}` : "Previous section",
      );
    }
    if (winNext && winNextLabel) {
      winNextLabel.textContent = idx >= total - 1 ? `${nextMeta.title} ↺` : `${nextMeta.title} →`;
      winNext.setAttribute("aria-label", `Next section: ${nextMeta.title}`);
    }
    if (winResume && winResumeLabel) {
      winResumeLabel.textContent = `← Back to ${meta.title}`;
      winResume.setAttribute("aria-label", `Back to ${meta.title}`);
    }
    if (winToggle) {
      winToggle.setAttribute("aria-pressed", String(!windowOpen));
    }
  };

  const syncRackPaused = () => {
    rackHandle?.setPaused(layoutState.mode === "window" && windowOpen && layoutState.windowFrame === "compact");
  };

  const focusActiveHeading = (idx: number) => {
    const heading = chapters[idx]?.querySelector<HTMLElement>("h1, h2");
    if (!heading) return;
    requestAnimationFrame(() => heading.focus({ preventScroll: true }));
  };

  let chapterAnnounceTimer = 0;
  const announceChapter = (idx: number, immediate = false) => {
    const meta = BAY_META[idx] ?? { code: `U${idx + 1}`, title: `Unit ${idx + 1}` };
    const msg = `Section ${idx + 1} of ${chapters.length}: ${meta.title}`;
    window.clearTimeout(chapterAnnounceTimer);
    if (immediate) {
      (window as any).__announce?.(msg);
      return;
    }
    chapterAnnounceTimer = window.setTimeout(() => {
      (window as any).__announce?.(msg);
    }, 320);
  };

  const syncWindowA11y = () => {
    if (osWindow) {
      const closedInWindow = layoutState.mode === "window" && !windowOpen;
      osWindow.inert = closedInWindow;
      if (closedInWindow) osWindow.setAttribute("aria-hidden", "true");
      else osWindow.removeAttribute("aria-hidden");
    }
  };

  let winAnimTimer = 0;
  const setWindowOpen = (open: boolean, animate = true) => {
    windowOpen = open;
    const root = document.documentElement;
    if (!open) ensureRackBooted();
    if (animate) {
      window.clearTimeout(winAnimTimer);
      root.dataset.winAnimating = "true";
      winAnimTimer = window.setTimeout(() => {
        delete root.dataset.winAnimating;
      }, 240);
    }
    root.dataset.windowOpen = String(open);
    if (osWindow) osWindow.toggleAttribute("data-lenis-prevent", layoutState.mode === "window" && open);
    syncWindowA11y();

    if (layoutState.mode === "window") {
      if (!open) {
        openedRackUnit = -1;
        window.scrollTo(0, 0);
      } else {
        window.scrollTo(0, 0);
      }
    }
    updateWindowChrome(activeIndex);
    syncRackPaused();
  };

  const showOnly = (next: number) => {
    chapters.forEach((c, i) => {
      const active = i === next;
      c.dataset.active = String(active);
      c.inert = !active;
      if (active) c.removeAttribute("aria-hidden");
      else c.setAttribute("aria-hidden", "true");
      if (layoutState.mode === "window") {
        c.style.transform = "";
      }
    });
    updateWindowChrome(next);
  };

  const syncLayout = () => {
    const prevMode = layoutState.mode;
    const prevFrame = layoutState.windowFrame;
    const nextState = getLayoutState();
    // Ignore minor viewport height changes (mobile browser chrome show/hide) that keep the same layout mode/frame.
    if (prevMode === nextState.mode && prevFrame === nextState.windowFrame) return;

    layoutState = nextState;
    const root = document.documentElement;
    root.dataset.layout = layoutState.mode;
    root.dataset.windowFrame = layoutState.windowFrame;
    if (spacer) {
      spacer.style.height = layoutState.mode === "window" ? "0px" : `${chapters.length * 200}svh`;
    }
    if (osWindow) osWindow.toggleAttribute("data-lenis-prevent", layoutState.mode === "window" && windowOpen);
    (window as any).__syncLenis?.(layoutState.mode === "split");
    if (layoutState.mode === "window") {
      window.scrollTo(0, 0);
    }
    rackHandle?.setPresentationMode(layoutState.mode === "split" ? "split" : "front");

    if (prevMode !== layoutState.mode) {
      if (layoutState.mode === "window") {
        openedRackUnit = windowOpen ? activeIndex : -1;
        windowEjects.forEach((_, k) => {
          windowEjects[k] = k === openedRackUnit ? 1 : 0;
        });
        showOnly(activeIndex);
        updateRail(activeIndex);
      } else {
        jump = null;
        fastTravel = null;
        showOnly(activeIndex);
      }
    }
    syncWindowA11y();
    syncRackPaused();
    if (!(layoutState.mode === "window" && windowOpen && layoutState.windowFrame === "compact")) {
      ensureRackBooted();
    }
  };

  window.addEventListener("resize", syncLayout);

  // Initialize non-active chapters retracted inside their server bay (never flashing "out")
  chapters.forEach((c, i) => {
    [...c.children].forEach((el, k) => (el as HTMLElement).style.setProperty("--i", String(k)));
    c.inert = i !== activeIndex;
    if (i === activeIndex) c.removeAttribute("aria-hidden");
    else c.setAttribute("aria-hidden", "true");
    if (layoutState.mode === "window") {
      c.dataset.active = String(i === activeIndex);
      c.style.transform = "";
    } else if (i !== activeIndex) {
      c.style.setProperty("--reveal", "0");
      c.style.transform = "translate3d(760px, 0, 0)";
    } else {
      c.style.setProperty("--reveal", currentReveal.toFixed(4));
      if (currentReveal <= 0.001) {
        c.style.transform = "translate3d(760px, 0, 0)";
      }
    }
  });
  updateWindowChrome(activeIndex);

  // chapter rail
  const railBtns = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-goto]"));
  const railDots = Array.from(document.querySelectorAll<HTMLElement>("[data-rail-dot]"));
  const railNums = Array.from(document.querySelectorAll<HTMLElement>("[data-rail-num]"));
  const railLabels = Array.from(document.querySelectorAll<HTMLElement>("[data-rail-label]"));

  const updateRail = (idx: number) => {
    railBtns.forEach((b, i) => {
      const on = i === idx;
      b.dataset.active = String(on);
      if (on) b.setAttribute("aria-current", "step");
      else b.removeAttribute("aria-current");
      const dot = railDots[i];
      const num = railNums[i];
      const lbl = railLabels[i];
      if (dot) {
        dot.classList.toggle("bg-ember", on);
        dot.classList.toggle("shadow-[0_0_8px_rgba(212,107,66,0.75)]", on);
        dot.classList.toggle("bg-paper/25", !on);
      }
      if (num) {
        num.classList.toggle("text-ember", on);
        num.classList.toggle("text-dim/75", !on);
      }
      if (lbl) {
        lbl.classList.toggle("text-paper", on);
        lbl.classList.toggle("text-dim", !on);
      }
    });
  };

  const goToChapter = (i: number) => {
    const targetIdx = Math.max(0, Math.min(chapters.length - 1, i));

    if (layoutState.mode === "window") {
      openedRackUnit = targetIdx;
      activeIndex = targetIdx;
      setWindowOpen(true);
      showOnly(targetIdx);
      updateRail(targetIdx);
      return;
    }

    const max = document.documentElement.scrollHeight - window.innerHeight;
    const destY = (targetIdx / Math.max(1, chapters.length - 1)) * max;

    const prevElapsed = jump ? performance.now() - jump.start : 0;
    const fromIdx = jump
      ? prevElapsed < jump.closeDur
        ? jump.from
        : prevElapsed >= jump.closeDur + jump.scrollDur
          ? jump.to
          : Math.round(jump.from + (jump.to - jump.from) * lastPose.rackT)
      : activeIndex;
    const startEject = lastPose.ejects[fromIdx] ?? 0;
    const needsClose = fromIdx !== targetIdx && (startEject > 0.01 || currentReveal > 0.01);
    const closeDur = reduce ? 0 : needsClose ? 450 : 0;
    const scrollDur = reduce
      ? 0
      : fromIdx === targetIdx
        ? Math.abs(destY - window.scrollY) > 4
          ? 260
          : 0
        : 420 + Math.abs(targetIdx - fromIdx) * 145;
    const openDur = reduce ? 0 : 450;
    const dur = closeDur + scrollDur + openDur;

    fastTravel = null;
    const lenis = (window as any).__lenis;
    if (lenis) lenis.stop();

    if (dur === 0) {
      jump = null;
      scrub = targetIdx;
      if (lenis) {
        lenis.start();
        lenis.scrollTo(destY, { immediate: true });
      } else {
        window.scrollTo(0, destY);
      }
      return;
    }

    jump = {
      from: fromIdx,
      to: targetIdx,
      start: performance.now(),
      closeDur,
      scrollDur,
      openDur,
      dur,
      startReveal: currentReveal,
      startEject,
      startY: window.scrollY,
      destY,
      wheelAccum: 0,
    };
  };

  let bayOpenTimer = 0;
  const openSelectedWindow = (idx: number, moveFocus = false) => {
    window.clearTimeout(bayOpenTimer);
    openedRackUnit = idx;
    activeIndex = idx;
    setWindowOpen(true);
    showOnly(idx);
    updateRail(idx);
    announceChapter(idx, true);
    if (moveFocus) focusActiveHeading(idx);
  };

  railBtns.forEach((b, i) => {
    b.addEventListener("click", () => {
      goToChapter(i);
      announceChapter(i, true);
    });
    b.addEventListener("keydown", (e) => {
      let next = -1;
      if (e.key === "ArrowDown") next = (i + 1) % railBtns.length;
      else if (e.key === "ArrowUp") next = (i - 1 + railBtns.length) % railBtns.length;
      else if (e.key === "Home") next = 0;
      else if (e.key === "End") next = railBtns.length - 1;
      if (next >= 0) {
        e.preventDefault();
        railBtns[next]?.focus();
      }
    });
  });
  winPrev?.addEventListener("click", () => {
    if (activeIndex > 0) {
      const next = activeIndex - 1;
      goToChapter(next);
      announceChapter(next, true);
    }
  });
  winNext?.addEventListener("click", () => {
    const next = (activeIndex + 1) % chapters.length;
    goToChapter(next);
    announceChapter(next, true);
  });
  winToggle?.addEventListener("click", () => {
    window.clearTimeout(bayOpenTimer);
    setWindowOpen(false);
    (window as any).__announce?.(
      "Interactive 3D server rack opened. Activate Back to return to content.",
    );
    requestAnimationFrame(() => winResume?.focus());
  });
  winResume?.addEventListener("click", () => openSelectedWindow(activeIndex, true));
  document.querySelector("[data-back-top]")?.addEventListener("click", () => {
    goToChapter(0);
    announceChapter(0, true);
  });
  document.addEventListener("profilecard:contact", () => {
    goToChapter(5);
    announceChapter(5, true);
  });

  const gridBtn = document.querySelector<HTMLButtonElement>("[data-grid-toggle]");
  gridBtn?.addEventListener("click", () => {
    const next = gridBtn.getAttribute("aria-pressed") !== "true";
    gridBtn.setAttribute("aria-pressed", String(next));
    rackHandle?.setGrid(next);
    (window as any).__announce?.(next ? "Wireframe overlay enabled" : "Wireframe overlay disabled");
  });

  /**
   * Segmented jump choreography:
   * 1) `closeDur` (450ms): active content retracts and current drawer glides shut
   * 2) `scrollDur` (distance-based): pure Apple-eased scroll along the rack while closed
   * 3) `openDur` (450ms): target drawer slides out and content reveals
   */
  const computeJumpPose = (j: JumpState, elapsed: number, n: number) => {
    const ejects = new Array<number>(n).fill(0);

    // Phase 1: Retract content + close current server bay (450ms)
    if (elapsed < j.closeDur && j.closeDur > 0) {
      const tClose = Math.max(0, Math.min(1, elapsed / j.closeDur));
      const contentIn = appleOut(0, 0.58, tClose);
      const drawerClose = appleSheet(0.18, 1, tClose);
      ejects[j.from] = j.startEject * (1 - drawerClose);
      return {
        fromUnit: j.from,
        toUnit: j.to,
        rackT: 0,
        ejects,
        active: j.from,
        reveal: j.startReveal * (1 - contentIn),
      };
    }

    // Phase 2: Dedicated Apple-eased scroll to destination bay
    const scrollEnd = j.closeDur + j.scrollDur;
    if (elapsed < scrollEnd && j.scrollDur > 0) {
      const tScroll = Math.max(0, Math.min(1, (elapsed - j.closeDur) / j.scrollDur));
      const rackT = appleGlide(0, 1, tScroll);
      return {
        fromUnit: j.from,
        toUnit: j.to,
        rackT,
        ejects,
        active: j.to,
        reveal: 0,
      };
    }

    // Phase 3: Open target server bay + reveal content (450ms)
    const tOpen = j.openDur > 0 ? Math.max(0, Math.min(1, (elapsed - scrollEnd) / j.openDur)) : 1;
    const baseEject = j.from === j.to && j.closeDur === 0 ? j.startEject : 0;
    const baseReveal = j.from === j.to && j.closeDur === 0 ? j.startReveal : 0;
    const drawerOpen = appleOut(0, 0.72, tOpen);
    const contentOut = appleOut(0.28, 1, tOpen);
    ejects[j.to] = baseEject + (1 - baseEject) * drawerOpen;

    return {
      fromUnit: j.from,
      toUnit: j.to,
      rackT: 1,
      ejects,
      active: j.to,
      reveal: baseReveal + (1 - baseReveal) * contentOut,
    };
  };

  const applyPanelLayout = (portX: number, portY: number, faceH: number, eject: number) => {
    const panel = chapters[activeIndex];
    if (!panel) return;

    panel.style.setProperty("--eject", eject.toFixed(4));
    panel.style.setProperty("--reveal", currentReveal.toFixed(4));

    if (layoutState.mode === "split" && stageCol && stageClip) {
      osWindow?.style.removeProperty("--win-reveal");

      const h = panel.offsetHeight || 0;
      const contentH = Math.max(panel.scrollHeight || 0, h);
      const headerSafe = 72;
      const margin = 48;
      const maxTop = Math.max(headerSafe, window.innerHeight - h - margin);
      const targetTop = portY - h * 0.5;
      const y = Math.min(Math.max(targetTop, headerSafe), maxTop);
      panel.dataset.overflow = contentH > window.innerHeight - headerSafe - margin ? "true" : "false";

      const out = 1 - currentReveal;
      const edgeX = Math.max(0, portX + 2);
      const clipRight = Math.max(0, window.innerWidth - edgeX);
      stageClip.style.clipPath = `inset(0px ${clipRight.toFixed(1)}px 0px 0px)`;

      if (ditherEdgeUrl) {
        const featherW = Math.min(edgeX, Math.round(18 + 118 * smoothstep(0, 0.25, out)));
        const solidW = Math.max(0, edgeX - featherW);
        // Overlap solid layer by 1px into the solid left edge of the Bayer strip to prevent subpixel seams
        const sizeStr = `${(solidW + 1).toFixed(1)}px 100%, ${Math.max(1, featherW).toFixed(1)}px ${DITHER_TILE_H}px`;
        const posStr = `0px 0px, ${solidW.toFixed(1)}px 0px`;
        stageClip.style.maskSize = sizeStr;
        stageClip.style.webkitMaskSize = sizeStr;
        stageClip.style.maskPosition = posStr;
        stageClip.style.webkitMaskPosition = posStr;
      }

      const colRect = stageCol.getBoundingClientRect();
      const slideDist = Math.max(colRect.width, portX - colRect.left + 24);
      const tx = out * slideDist;
      // Offset Y in compositor transform rather than CSS top so initial WebGL settle causes zero CLS.
      panel.style.transform =
        `translate3d(${tx.toFixed(1)}px, ${y.toFixed(1)}px, 0) ` +
        `rotateY(${(out * -14).toFixed(2)}deg) ` +
        `scale(${(0.94 + currentReveal * 0.06).toFixed(3)})`;
    } else {
      if (stageClip) {
        stageClip.style.clipPath = "";
        stageClip.style.maskSize = "";
        stageClip.style.webkitMaskSize = "";
        stageClip.style.maskPosition = "";
        stageClip.style.webkitMaskPosition = "";
      }
      delete panel.dataset.overflow;
      panel.style.transform = "";
      panel.style.removeProperty("--anchor-y");
      osWindow?.style.setProperty("--win-reveal", "1");
    }
  };

  // Cancel explicit click jumps only on deliberate fresh user scroll (absorb decaying trackpad inertia).
  const abortJumpToScroll = () => {
    if (!jump) return;
    const target = getTargetScrub();
    const lenis = (window as any).__lenis;
    lenis?.start?.();
    lenis?.scrollTo?.(window.scrollY, { immediate: true });
    const fromIdx = activeIndex;
    const startEject = lastPose.ejects[fromIdx] ?? 0;
    jump = null;
    if (currentReveal < 0.05 || Math.abs(target - scrub) > 0.55 || Math.abs(target - fromIdx) > 1.05) {
      fastTravel = {
        phase: "closing",
        from: fromIdx,
        to: Math.max(0, Math.min(chapters.length - 1, Math.round(target))),
        rackS: scrub,
        t: 0,
        startReveal: currentReveal,
        startEject,
        lastTarget: target,
        stableFrames: 0,
      };
    } else {
      scrub = target;
    }
  };

  window.addEventListener(
    "wheel",
    (e) => {
      if (!jump) return;
      if (performance.now() - jump.start < 160) return;
      jump.wheelAccum += Math.abs(e.deltaY);
      if (jump.wheelAccum >= 75) abortJumpToScroll();
    },
    { passive: true },
  );
  let touchStartY = 0;
  window.addEventListener(
    "touchstart",
    (e) => {
      if (e.touches[0]) touchStartY = e.touches[0].clientY;
    },
    { passive: true },
  );
  window.addEventListener(
    "touchmove",
    (e) => {
      if (!jump || performance.now() - jump.start < 160) return;
      const cy = e.touches[0]?.clientY ?? touchStartY;
      if (Math.abs(cy - touchStartY) >= 28) abortJumpToScroll();
    },
    { passive: true },
  );

  const computeFastTravelPose = (ft: FastTravelState, target: number, dt: number, n: number) => {
    const ejects = new Array<number>(n).fill(0);

    if (ft.phase === "closing") {
      ft.t = Math.min(1, ft.t + dt / 0.24);
      const revIn = smoothstep(0, 0.5, ft.t);
      const drClose = smoothstep(0.5, 1, ft.t);
      ejects[ft.from] = ft.startEject * (1 - drClose);
      const base = computePose(ft.rackS, n);
      if (ft.t >= 1) {
        ft.phase = "scrolling";
        ft.t = 0;
        ft.lastTarget = target;
        ft.stableFrames = 0;
      }
      return {
        fromUnit: base.fromUnit,
        toUnit: base.toUnit,
        rackT: base.rackT,
        ejects,
        active: ft.from,
        reveal: ft.startReveal * (1 - revIn),
      };
    }

    if (ft.phase === "scrolling") {
      ft.rackS += (target - ft.rackS) * 0.22;
      ft.stableFrames = Math.abs(target - ft.lastTarget) < 0.015 ? ft.stableFrames + 1 : 0;
      ft.lastTarget = target;

      if (Math.abs(target - ft.rackS) < 0.035 && ft.stableFrames >= 3) {
        ft.rackS = target;
        ft.to = Math.max(0, Math.min(n - 1, Math.round(target)));
        ft.phase = "opening";
        ft.t = 0;
      }

      const clamped = Math.max(0, Math.min(n - 1, ft.rackS));
      const fU = Math.min(Math.max(0, Math.floor(clamped)), Math.max(0, n - 2));
      const rT = n > 1 ? clamped - fU : 0;
      return {
        fromUnit: fU,
        toUnit: Math.min(n - 1, fU + 1),
        rackT: rT,
        ejects,
        active: Math.max(0, Math.min(n - 1, Math.round(ft.rackS))),
        reveal: 0,
      };
    }

    // phase === "opening": if user starts dragging/scrolling far away again, close smoothly and re-scroll
    if (Math.abs(target - ft.to) > 0.55) {
      ft.from = ft.to;
      ft.rackS = ft.to;
      ft.startReveal = currentReveal;
      ft.startEject = lastPose.ejects[ft.to] ?? 0;
      ft.phase = "closing";
      ft.t = 0;
      return computeFastTravelPose(ft, target, 0, n);
    }

    ft.t = Math.min(1, ft.t + dt / 0.72);
    const destPose = computePose(target, n);
    const drawerOpen = smoothstep(0, 0.7, ft.t);
    const contentOut = smoothstep(0.7, 1, ft.t);
    const destReady = destPose.active === ft.to;
    ejects[ft.to] = destReady ? (destPose.ejects[ft.to] ?? 1) * drawerOpen : 0;
    const reveal = destReady ? destPose.reveal * contentOut : 0;

    if (ft.t >= 1) {
      scrub = target;
      fastTravel = null;
    }

    return {
      fromUnit: destPose.fromUnit,
      toUnit: destPose.toUnit,
      rackT: destPose.rackT,
      ejects,
      active: destReady ? ft.to : destPose.active,
      reveal,
    };
  };

  let prevTickTime = performance.now();
  let scrubRaf = 0;
  const tickScrub = () => {
    scrubRaf = requestAnimationFrame(tickScrub);
    const now = performance.now();
    const dt = Math.min(0.05, Math.max(0.001, (now - prevTickTime) / 1000));
    prevTickTime = now;

    let pose;
    if (layoutState.mode === "window") {
      scrub = activeIndex;

      for (let k = 0; k < windowEjects.length; k++) {
        const targetEj = k === openedRackUnit ? 1 : 0;
        windowEjects[k] = reduce
          ? targetEj
          : Math.abs(targetEj - windowEjects[k]) < 0.002
            ? targetEj
            : windowEjects[k] + (targetEj - windowEjects[k]) * 0.14;
      }

      currentReveal = 1;
      pose = {
        fromUnit: activeIndex,
        toUnit: activeIndex,
        rackT: 0,
        ejects: windowEjects,
        active: activeIndex,
        reveal: 1,
      };
      lastPose = pose;

      if (rackHandle) {
        rackHandle.setPose(pose.fromUnit, pose.toUnit, pose.rackT, pose.ejects, pose.active);
      }
      if (!rackHandle || reduce) {
        applyPanelLayout(window.innerWidth * 0.58, window.innerHeight * 0.5, 110, 1);
      }
      return;
    }

    const target = getTargetScrub();

    // Fast multi-chapter scroll, scrollbar drag, or Home/End/PageDown: travel closed along the rack instead of flashing intermediate content.
    if (
      !jump &&
      !fastTravel &&
      !reduce &&
      (Math.abs(target - scrub) > 0.55 || Math.abs(target - activeIndex) > 1.05)
    ) {
      fastTravel = {
        phase: currentReveal <= 0.01 && (lastPose.ejects[activeIndex] ?? 0) <= 0.01 ? "scrolling" : "closing",
        from: activeIndex,
        to: Math.max(0, Math.min(chapters.length - 1, Math.round(target))),
        rackS: scrub,
        t: 0,
        startReveal: currentReveal,
        startEject: lastPose.ejects[activeIndex] ?? 0,
        lastTarget: target,
        stableFrames: 0,
      };
    }

    if (jump) {
      const elapsed = now - jump.start;
      pose = computeJumpPose(jump, elapsed, chapters.length);
      const yNow = jump.startY + (jump.destY - jump.startY) * pose.rackT;
      window.scrollTo(0, yNow);
      if (elapsed >= jump.dur) {
        const lenis = (window as any).__lenis;
        window.scrollTo(0, jump.destY);
        lenis?.start?.();
        lenis?.scrollTo?.(jump.destY, { immediate: true });
        scrub = jump.to;
        jump = null;
      }
    } else if (fastTravel) {
      pose = computeFastTravelPose(fastTravel, target, dt, chapters.length);
    } else {
      const delta = target - scrub;
      scrub = reduce || Math.abs(delta) < 0.0004 ? target : scrub + delta * 0.12;
      pose = computePose(scrub, chapters.length);
    }

    lastPose = pose;
    currentReveal = reduce ? 1 : pose.reveal;

    if (pose.active !== activeIndex) {
      const prevPanel = chapters[activeIndex];
      const nextPanel = chapters[pose.active];
      prevPanel?.style.setProperty("--reveal", "0");
      if (nextPanel) {
        nextPanel.style.setProperty("--reveal", currentReveal.toFixed(4));
        if (currentReveal <= 0.001) {
          nextPanel.style.transform = "translate3d(760px, 0, 0)";
        }
      }
      activeIndex = pose.active;
      showOnly(activeIndex);
      updateRail(activeIndex);
      if (!jump) announceChapter(activeIndex, false);
    }

    if (rackHandle) {
      rackHandle.setPose(pose.fromUnit, pose.toUnit, pose.rackT, pose.ejects, pose.active);
    }

    if (!rackHandle || reduce) {
      applyPanelLayout(window.innerWidth * 0.58, window.innerHeight * 0.5, 110, 1);
    }
  };
  scrubRaf = requestAnimationFrame(tickScrub);

  window.addEventListener("pageshow", (e) => {
    if (e.persisted) bootCurtain.finish({ instant: true });
    if (layoutState.mode === "window") {
      showOnly(activeIndex);
      updateRail(activeIndex);
      return;
    }
    if (jump) return;
    fastTravel = null;
    scrub = getTargetScrub();
    lastPose = computePose(scrub, chapters.length);
    activeIndex = lastPose.active;
    currentReveal = reduce ? 1 : lastPose.reveal;
    showOnly(activeIndex);
    updateRail(activeIndex);
  });

  let rackBootPromise: Promise<void> | null = null;
  const ensureRackBooted = () => {
    if (!canvas) {
      bootCurtain.finish({ instant: true });
      return Promise.resolve();
    }
    if (rackBootPromise) return rackBootPromise;
    rackBootPromise = (async () => {
      try {
        bootCurtain.setStage("LOADING FONTS", 0.28);
        if ("fonts" in document) {
          await Promise.all([
            document.fonts.load('400 12px "Maple Mono"'),
            document.fonts.load('500 12px "Maple Mono"'),
          ]).catch(() => {});
        }
        bootCurtain.setStage("MOUNTING 7U CHASSIS", 0.62);
        const { mountRack } = await import("../scene/rack");
        bootCurtain.setStage("COMPILING SHADERS", 0.84);
        const handle = mountRack(
          canvas,
          [
            { label: "IAM", sub: "about me", u: 2, kind: "compute", flicker: true },
            { label: "RUNTIME", sub: "my career", u: 4, kind: "compute", flicker: true },
            { label: "ARTIFACT", sub: "my projects", u: 8, kind: "compute", flicker: true },
            { label: "DAC", sub: "my music", u: 4, kind: "audio", flicker: true },
            { label: "DAM", sub: "photography", u: 1, kind: "appliance", flicker: true },
            { label: "GATEWAY", sub: "connect", u: 1, kind: "network", flicker: true },
            { label: "UPS / PDU", sub: "site footer", u: 2, kind: "power" },
          ],
          {
            initialMode: layoutState.mode === "split" ? "split" : "front",
            onFirstFrame: () => {
              bootCurtain.finish();
            },
            onStats: ({ fps, tris }) => {
              const el = document.querySelector<HTMLElement>("[data-hud]");
              if (el) {
                el.textContent = `${fps} fps · ${tris >= 1000 ? (tris / 1000).toFixed(0) + "k" : tris} tris · webgl2`;
              }
            },
          },
        );
        if (handle) {
          rackHandle = handle;
          handle.setPresentationMode(layoutState.mode === "split" ? "split" : "front");
          handle.setPose(lastPose.fromUnit, lastPose.toUnit, lastPose.rackT, lastPose.ejects, lastPose.active);
          handle.setFrameCallback((f) => {
            applyPanelLayout(f.portX, f.portY, f.faceH, f.eject);
          });
          syncRackPaused();
        } else {
          bootCurtain.finish();
        }
      } catch {
        bootCurtain.finish();
      }
    })();
    return rackBootPromise;
  };

  winToggle?.addEventListener("pointerdown", () => ensureRackBooted(), { passive: true, once: true });

  // On compact mobile, the full-screen panel covers the canvas at startup; load WebGL on demand when opening the rack.
  const deferRackAtBoot =
    layoutState.mode === "window" && windowOpen && layoutState.windowFrame === "compact";
  if (canvas && !deferRackAtBoot) {
    ensureRackBooted();
  } else {
    Promise.race([
      "fonts" in document ? document.fonts.ready : Promise.resolve(),
      new Promise((resolve) => window.setTimeout(resolve, 750)),
    ]).then(() => {
      requestAnimationFrame(() => bootCurtain.finish());
    });
  }

  const hddTip = document.querySelector<HTMLElement>("[data-hdd-tip]");

  const handleRackTap = (clientX: number, clientY: number, target: HTMLElement | null) => {
    if (!rackHandle) return false;
    if (layoutState.mode === "window" && windowOpen && layoutState.windowFrame === "compact") return false;
    if (target?.closest("a, button, header, nav, [data-mobile-dock], [data-os-window]")) return false;
    if (rackHandle.hitHdd(clientX, clientY)) {
      window.open("https://eve-0607.github.io/", "_blank", "noopener,noreferrer");
      return true;
    }
    const hit = rackHandle.hitUnit(clientX, clientY);
    if (hit < 0) return false;
    if (layoutState.mode === "window" && !windowOpen && !reduce) {
      window.clearTimeout(bayOpenTimer);
      openedRackUnit = hit;
      activeIndex = hit;
      updateWindowChrome(hit);
      // Brief eject preview on the front-facing bay so the tap feels physically anchored before opening.
      bayOpenTimer = window.setTimeout(() => {
        openSelectedWindow(hit);
      }, 210);
    } else {
      goToChapter(hit);
    }
    return true;
  };

  let rackPointerDown: { x: number; y: number; t: number; id: number } | null = null;
  let lastTouchTapAt = 0;

  // Handle touch taps directly on pointerup so iOS Safari never drops taps over non-button canvas regions.
  canvas?.addEventListener("pointerdown", (e) => {
    if (e.pointerType !== "touch") return;
    rackPointerDown = { x: e.clientX, y: e.clientY, t: performance.now(), id: e.pointerId };
  });

  canvas?.addEventListener("pointerup", (e) => {
    if (e.pointerType !== "touch" || !rackPointerDown || e.pointerId !== rackPointerDown.id) return;
    const dx = e.clientX - rackPointerDown.x;
    const dy = e.clientY - rackPointerDown.y;
    const dt = performance.now() - rackPointerDown.t;
    rackPointerDown = null;
    if (Math.hypot(dx, dy) > 14 || dt > 450) return;
    if (handleRackTap(e.clientX, e.clientY, e.target as HTMLElement | null)) {
      lastTouchTapAt = performance.now();
    }
  });

  canvas?.addEventListener("pointercancel", () => {
    rackPointerDown = null;
  });

  // Click the floor-side EVE archive HDD stack or any 3D rack unit directly.
  window.addEventListener("click", (e) => {
    if (performance.now() - lastTouchTapAt < 450) return;
    handleRackTap(e.clientX, e.clientY, e.target as HTMLElement | null);
  });

  window.addEventListener(
    "pointermove",
    (e) => {
      if (!rackHandle || e.pointerType === "touch") return;
      if (layoutState.mode === "window" && windowOpen && layoutState.windowFrame === "compact") return;
      const t = e.target as HTMLElement | null;
      if (t?.closest("a, button, header, nav, [data-mobile-dock], [data-os-window]")) {
        document.body.style.cursor = "";
        rackHandle.setHddHover(false);
        rackHandle.setHoverUnit(-1);
        hddTip?.classList.add("hidden");
        return;
      }
      const hddHit = rackHandle.hitHdd(e.clientX, e.clientY);
      rackHandle.setHddHover(hddHit);
      if (hddHit) {
        rackHandle.setHoverUnit(-1);
        document.body.style.cursor = "pointer";
        if (hddTip) {
          hddTip.classList.remove("hidden");
          const tipW = hddTip.offsetWidth || 175;
          const x = Math.min(window.innerWidth - tipW - 14, Math.max(12, e.clientX - tipW / 2));
          const y = Math.max(12, e.clientY - 38);
          hddTip.style.transform = `translate3d(${Math.round(x)}px, ${Math.round(y)}px, 0)`;
        }
        return;
      }
      hddTip?.classList.add("hidden");
      const unitHit = rackHandle.hitUnit(e.clientX, e.clientY);
      rackHandle.setHoverUnit(unitHit);
      document.body.style.cursor = unitHit >= 0 ? "pointer" : "";
    },
    { passive: true },
  );

  // Only settle gently when idle mid-transition (never override settled chapters).
  (window as any).__syncLenis?.(layoutState.mode === "split");
  let snapTimer = 0;

  const snapEaseInOut = (t: number) =>
    t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

  const scheduleSnap = () => {
    window.clearTimeout(snapTimer);
    snapTimer = window.setTimeout(() => {
      if (layoutState.mode !== "split" || jump || fastTravel) return;
      const activeLenis = (window as any).__lenis;
      if (activeLenis && Math.abs(activeLenis.velocity) > 0.2) {
        scheduleSnap();
        return;
      }
      const max = document.documentElement.scrollHeight - window.innerHeight;
      if (max <= 0) return;
      const targetS = (window.scrollY / max) * (chapters.length - 1);
      const pose = computePose(targetS, chapters.length);
      if (pose.reveal >= 0.92) return;

      const nearestIdx = Math.round(targetS);
      const stepSize = max / Math.max(1, chapters.length - 1);
      const nearestY = nearestIdx * stepSize;
      const dist = Math.abs(nearestY - window.scrollY);
      if (dist < 6) return;

      const distFrac = Math.min(1, dist / Math.max(1, stepSize));
      const duration = 0.95 + distFrac * 1.1;

      if (activeLenis) {
        activeLenis.scrollTo(nearestY, { duration, easing: snapEaseInOut });
      } else {
        window.scrollTo({ top: nearestY, behavior: "smooth" });
      }
    }, 1100);
  };

  window.addEventListener("scroll", scheduleSnap, { passive: true });

  const scrollCue = document.querySelector<HTMLButtonElement>("[data-scroll-cue]");
  const syncScrollCue = () => {
    if (!scrollCue) return;
    const hidden = window.scrollY > 24;
    scrollCue.dataset.hidden = hidden ? "true" : "false";
    scrollCue.tabIndex = hidden ? -1 : 0;
  };
  syncScrollCue();
  window.addEventListener("scroll", syncScrollCue, { passive: true });
  scrollCue?.addEventListener("click", () => {
    goToChapter(1);
    announceChapter(1, true);
  });

  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy ?? "";
      try {
        await navigator.clipboard.writeText(text);
        const prev = btn.textContent;
        btn.textContent = "Copied";
        (window as any).__announce?.(`Copied ${text} to clipboard`);
        setTimeout(() => (btn.textContent = prev), 1400);
      } catch {
        btn.textContent = text;
      }
    });
  });

  const photoDialog = document.querySelector<HTMLDialogElement>("[data-photo-dialog]");
  const photoImg = document.querySelector<HTMLImageElement>("[data-photo-img]");
  const photoTitle = document.querySelector<HTMLElement>("[data-photo-title]");
  const photoMeta = document.querySelector<HTMLElement>("[data-photo-meta]");
  let lastPhotoTrigger: HTMLButtonElement | null = null;

  document.querySelectorAll<HTMLButtonElement>("[data-photo-open]").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!photoDialog || !photoImg) return;
      lastPhotoTrigger = btn;
      photoImg.src = btn.dataset.src ?? "";
      photoImg.alt = btn.dataset.title ?? "Photo preview";
      photoImg.classList.remove("hidden");
      if (photoTitle) photoTitle.textContent = btn.dataset.title ?? "";
      if (photoMeta) photoMeta.textContent = btn.dataset.meta ?? "";
      photoDialog.showModal();
    });
  });

  document.querySelector("[data-photo-close]")?.addEventListener("click", () => {
    photoDialog?.close();
  });

  photoDialog?.addEventListener("click", (e) => {
    if (e.target === photoDialog) photoDialog.close();
  });

  photoDialog?.addEventListener("close", () => {
    if (photoImg) {
      photoImg.classList.add("hidden");
      photoImg.removeAttribute("src");
    }
    lastPhotoTrigger?.focus();
    lastPhotoTrigger = null;
  });

  showOnly(activeIndex);
  updateRail(activeIndex);
</script>
