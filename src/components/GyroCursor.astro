---
// Precision mechanical gyroscope cursor for fine-pointer desktop devices.
// Zero idle CPU cost: animation loop sleeps as soon as velocity & tilt settle.
---

<div
  id="gyro-cursor"
  transition:persist="gyro-cursor"
  aria-hidden="true"
  class="gyro-cursor pointer-events-none fixed left-0 top-0 z-[9999] opacity-0 transition-opacity duration-150"
>
  <div id="gyro-ripple" class="gyro-ripple"></div>

  <div id="gyro-arrow" class="gyro-arrow">
    <svg viewBox="-9 -2 18 22" width="18" height="22" fill="none" aria-hidden="true">
      <!-- Tip pinned cleanly at origin (0, 0) in viewBox -->
      <path
        class="gyro-body"
        d="M0 0L7.2 14.8L0 11.4L-7.2 14.8Z"
        fill="var(--color-paper, #e6e9f2)"
        stroke="var(--color-rack, #0b0d12)"
        stroke-width="1.35"
        stroke-linejoin="round"
      />
      <circle class="gyro-pivot" cx="0" cy="8.5" r="1.45" fill="var(--color-ember, #8288ec)" />
    </svg>
  </div>
</div>

<style is:global>
  html.has-gyro-cursor,
  html.has-gyro-cursor * {
    cursor: none !important;
  }
  html.has-gyro-cursor input,
  html.has-gyro-cursor textarea,
  html.has-gyro-cursor select,
  html.has-gyro-cursor iframe,
  html.has-gyro-cursor [contenteditable="true"] {
    cursor: auto !important;
  }

  .gyro-cursor {
    display: none;
    will-change: transform, opacity;
  }

  html.has-gyro-cursor .gyro-cursor {
    display: block;
  }

  .gyro-arrow {
    position: fixed;
    left: 0;
    top: 0;
    margin-left: -9px;
    margin-top: -2px;
    transform-origin: 9px 2px;
    will-change: transform;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.55));
  }

  .gyro-arrow .gyro-body,
  .gyro-arrow .gyro-pivot {
    transition: fill 140ms ease;
  }

  .gyro-cursor[data-mode="interactive"] .gyro-arrow .gyro-body {
    fill: var(--color-cursor-hover);
  }

  .gyro-cursor[data-mode="interactive"] .gyro-arrow .gyro-pivot {
    fill: var(--color-rack);
  }

  .gyro-cursor[data-mode="rack"] .gyro-arrow .gyro-pivot {
    fill: var(--color-led);
  }

  .gyro-ripple {
    position: fixed;
    left: 0;
    top: 0;
    width: 34px;
    height: 34px;
    margin-left: -17px;
    margin-top: -17px;
    border: 1px solid var(--color-ember);
    border-radius: 9999px;
    opacity: 0;
    transform: translate3d(-100px, -100px, 0) scale(0.35);
    will-change: transform, opacity;
  }

  .gyro-ripple.is-active {
    animation: gyro-pulse 360ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes gyro-pulse {
    0% {
      opacity: 0.9;
      transform: translate3d(var(--rx, 0px), var(--ry, 0px), 0) scale(0.35);
    }
    100% {
      opacity: 0;
      transform: translate3d(var(--rx, 0px), var(--ry, 0px), 0) scale(1.65);
    }
  }
</style>

<script>
  (() => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) return;

    const root = document.documentElement;
    const container = document.getElementById("gyro-cursor");
    const arrow = document.getElementById("gyro-arrow");
    const ripple = document.getElementById("gyro-ripple");
    if (!container || !arrow || !ripple) return;

    const REST_ANGLE = -26;
    let targetX = -100;
    let targetY = -100;
    let prevX = -100;
    let prevY = -100;
    let curX = -100;
    let curY = -100;
    let angle = REST_ANGLE;
    let dipScale = 1;
    let visible = false;
    let initialized = false;
    let raf = 0;
    let scripted = false;

    const shortestDiff = (from: number, to: number) => (((to - from + 180) % 360) + 360) % 360 - 180;

    const wake = () => {
      if (!raf) raf = requestAnimationFrame(step);
    };

    const setModeForTarget = (el: EventTarget | null) => {
      if (!(el instanceof Element)) {
        container.dataset.mode = "default";
        return;
      }
      if (el.closest("input, textarea, select, iframe, [contenteditable='true']")) {
        visible = false;
        container.style.opacity = "0";
        return;
      }
      if (el.closest("a, button, [role='button'], summary, label, [data-copy], [tabindex]:not([tabindex='-1'])")) {
        container.dataset.mode = "interactive";
      } else if (el.closest("[data-rack-canvas]")) {
        container.dataset.mode = "rack";
      } else {
        container.dataset.mode = "default";
      }
    };

    const triggerRipple = (x: number, y: number) => {
      ripple.style.setProperty("--rx", `${x.toFixed(1)}px`);
      ripple.style.setProperty("--ry", `${y.toFixed(1)}px`);
      ripple.classList.remove("is-active");
      void ripple.offsetWidth;
      ripple.classList.add("is-active");
    };

    const step = () => {
      raf = 0;
      const vx = targetX - curX;
      const vy = targetY - curY;
      const speed = Math.hypot(vx, vy);

      // Smooth sub-pixel lock on arrow tip
      curX += vx * 0.45;
      curY += vy * 0.45;

      // Directional heading blended cleanly back to REST_ANGLE when pointer pauses
      const instVx = targetX - prevX;
      const instVy = targetY - prevY;
      const instSpeed = Math.hypot(instVx, instVy);
      prevX = targetX;
      prevY = targetY;

      let targetAngle = REST_ANGLE;
      if (instSpeed > 1.2 || speed > 1.2) {
        const refX = instSpeed > 0.6 ? instVx : vx;
        const refY = instSpeed > 0.6 ? instVy : vy;
        const heading = (Math.atan2(refX, -refY) * 180) / Math.PI;
        const weight = Math.min(1, Math.max(instSpeed, speed) / 14);
        targetAngle = REST_ANGLE + shortestDiff(REST_ANGLE, heading) * weight;
      }

      const dAng = shortestDiff(angle, targetAngle);
      angle += dAng * 0.24;
      dipScale += (1 - dipScale) * 0.22;

      arrow.style.transform = `translate3d(${curX.toFixed(2)}px, ${curY.toFixed(2)}px, 0) rotate(${angle.toFixed(2)}deg) scale(${dipScale.toFixed(3)})`;

      const settled =
        speed < 0.08 &&
        Math.abs(dAng) < 0.15 &&
        Math.abs(1 - dipScale) < 0.005 &&
        !scripted;

      if (visible && !settled) {
        raf = requestAnimationFrame(step);
      }
    };

    window.addEventListener(
      "pointermove",
      (e) => {
        if (e.pointerType !== "mouse") {
          visible = false;
          initialized = false;
          root.classList.remove("has-gyro-cursor");
          container.style.opacity = "0";
          return;
        }
        targetX = e.clientX;
        targetY = e.clientY;
        if (!initialized) {
          initialized = true;
          curX = prevX = targetX;
          curY = prevY = targetY;
          root.classList.add("has-gyro-cursor");
        }
        visible = true;
        container.style.opacity = "1";
        setModeForTarget(e.target);
        wake();
      },
      { passive: true },
    );

    window.addEventListener(
      "pointerdown",
      (e) => {
        if (e.pointerType !== "mouse") {
          visible = false;
          initialized = false;
          root.classList.remove("has-gyro-cursor");
          container.style.opacity = "0";
          return;
        }
        if (!initialized) return;
        dipScale = 0.82;
        triggerRipple(e.clientX, e.clientY);
        wake();
      },
      { passive: true },
    );

    window.addEventListener(
      "pointerup",
      () => {
        wake();
      },
      { passive: true },
    );

    document.addEventListener("pointerleave", () => {
      visible = false;
      container.style.opacity = "0";
    });

    window.addEventListener("blur", () => {
      visible = false;
      container.style.opacity = "0";
    });

    // Preserve cursor-hiding root class and re-evaluate hover state across ClientRouter swaps
    document.addEventListener("astro:after-swap", () => {
      if (!initialized) return;
      root.classList.add("has-gyro-cursor");
      setModeForTarget(document.elementFromPoint(targetX, targetY));
    });

    // Optional programmable cursor API matching scripted gyro cursor controls
    (window as any).__gyroCursor = {
      moveTo(x: number, y: number, duration = 450) {
        return new Promise<void>((resolve) => {
          scripted = true;
          if (!initialized) {
            initialized = true;
            curX = prevX = targetX = x;
            curY = prevY = targetY = y;
            root.classList.add("has-gyro-cursor");
          }
          visible = true;
          container.style.opacity = "1";
          const sx = targetX;
          const sy = targetY;
          const t0 = performance.now();
          const tickMove = (now: number) => {
            const p = Math.min(1, (now - t0) / Math.max(16, duration));
            const ease = p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;
            targetX = sx + (x - sx) * ease;
            targetY = sy + (y - sy) * ease;
            wake();
            if (p < 1) requestAnimationFrame(tickMove);
            else {
              scripted = false;
              wake();
              resolve();
            }
          };
          requestAnimationFrame(tickMove);
        });
      },
      click() {
        dipScale = 0.78;
        triggerRipple(targetX, targetY);
        wake();
      },
      wiggle() {
        return new Promise<void>((resolve) => {
          scripted = true;
          const base = angle;
          const t0 = performance.now();
          const tickWiggle = (now: number) => {
            const p = Math.min(1, (now - t0) / 360);
            angle = base + Math.sin(p * Math.PI * 5) * 18 * (1 - p);
            wake();
            if (p < 1) requestAnimationFrame(tickWiggle);
            else {
              scripted = false;
              wake();
              resolve();
            }
          };
          requestAnimationFrame(tickWiggle);
        });
      },
    };
  })();
</script>
