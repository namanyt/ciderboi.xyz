---
import "@fontsource-variable/inter";
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "@fontsource/maple-mono/400.css";
import "@fontsource/maple-mono/500.css";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import GyroCursor from "../components/GyroCursor.astro";
import RouteSweep from "../components/RouteSweep.astro";
import { site } from "../lib/content";
import { buildJsonLdGraph, pageUrl, resolveOgPath, resolveOgType } from "../lib/seo";

export interface Props {
  title?: string;
  description?: string;
  path?: string;
  ogImage?: string;
  ogType?: "website" | "profile";
  ogAlt?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  path = "/",
  ogImage,
  ogType,
  ogAlt,
  noindex = false,
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const pageDescription = description ?? site.description;
const canonical = pageUrl(path);
const resolvedOgPath = resolveOgPath(path, ogImage);
const resolvedOgType = resolveOgType(path, ogType);
const ogImageUrl = new URL(resolvedOgPath, site.url).toString();
const resolvedOgAlt = ogAlt ?? `${pageTitle} — ${site.tagline}`;
const ogImageMime = resolvedOgPath.endsWith(".svg")
  ? "image/svg+xml"
  : resolvedOgPath.endsWith(".avif")
    ? "image/avif"
    : resolvedOgPath.endsWith(".webp")
      ? "image/webp"
      : /\.jpe?g$/i.test(resolvedOgPath)
        ? "image/jpeg"
        : "image/png";
const structuredData = noindex ? null : buildJsonLdGraph(jsonLd);
---

<!doctype html>
<html lang="en" class="bg-ink">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={site.name} />
    <meta
      name="robots"
      content={noindex
        ? "noindex, nofollow"
        : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0c0e11" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {!noindex && <meta property="og:url" content={canonical} />}
    {
      resolvedOgType === "profile" && (
        <>
          <meta property="profile:first_name" content="Nitya" />
          <meta property="profile:last_name" content="Naman" />
          <meta property="profile:username" content={site.handle} />
        </>
      )
    }
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content={ogImageMime} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={resolvedOgAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={resolvedOgAlt} />
    {
      !noindex && (
        <>
          <link rel="alternate" type="text/markdown" href="/llms.txt" title="LLM Summary" />
          <link rel="alternate" type="text/markdown" href="/llms-full.txt" title="LLM Full Context" />
        </>
      )
    }

    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <ClientRouter fallback="none" />
    <slot name="head" />
  </head>

  <body class="min-h-dvh antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-ink-2 focus:px-3 focus:py-2 focus:font-mono focus:text-xs"
    >
      Skip to content
    </a>

    <p id="sr-announce" transition:persist="sr-announce" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>

    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>

    <script>
      import Lenis from "lenis";

      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      let lenis: Lenis | null = null;
      let rafId = 0;

      const tick = (time: number) => {
        if (!lenis) {
          rafId = 0;
          return;
        }
        lenis.raf(time);
        rafId = requestAnimationFrame(tick);
      };

      const syncLenis = (enabled: boolean) => {
        if (reduce) return;
        if (enabled) {
          if (!lenis) {
            lenis = new Lenis({
              lerp: 0.085,
              wheelMultiplier: 1,
              touchMultiplier: 1.5,
              smoothWheel: true,
              syncTouch: false,
              allowNestedScroll: true,
            });
            (window as any).__lenis = lenis;
          } else {
            lenis.start();
            lenis.resize();
          }
          if (!rafId) {
            rafId = requestAnimationFrame(tick);
          }
        } else if (lenis) {
          // Destroy Lenis in window/mobile mode so its non-passive touch listeners never intercept native horizontal/vertical touch scrolls.
          if (rafId) {
            cancelAnimationFrame(rafId);
            rafId = 0;
          }
          lenis.destroy();
          lenis = null;
          (window as any).__lenis = null;
        }
      };

      (window as any).__syncLenis = syncLenis;
      (window as any).__syncPageScroll = () => {
        if (lenis) {
          lenis.scrollTo(window.scrollY, { immediate: true, force: true });
          lenis.resize();
        }
      };
      syncLenis(document.documentElement.dataset.layout !== "window");

      document.addEventListener("astro:page-load", () => {
        syncLenis(document.documentElement.dataset.layout !== "window");
        if (lenis) {
          lenis.scrollTo(window.scrollY, { immediate: true, force: true });
          lenis.resize();
        }
      });

      const srEl = document.getElementById("sr-announce");
      let srTimer = 0;
      (window as any).__announce = (message: string) => {
        if (!srEl || !message) return;
        window.clearTimeout(srTimer);
        srEl.textContent = "";
        srTimer = window.setTimeout(() => {
          srEl.textContent = message;
        }, 20);
      };
    </script>
    <RouteSweep />
    <GyroCursor />
  </body>
</html>
